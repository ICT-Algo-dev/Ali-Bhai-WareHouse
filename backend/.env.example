NODE_ENV=production
PORT=3000
TRUST_PROXY_HOPS=1
FORCE_HTTPS=true
FRONTEND_DIST_DIR=dist
MONGODB_URI=mongodb://127.0.0.1:27017/warehouse_fulfillment
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.co.uk,https://www.yourdomain.co.uk
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Warehouse & Fulfilment <no-reply@yourdomain.co.uk>
BUSINESS_NAME=Warehouse & Fulfilment
BUSINESS_ADDRESS=36 Roxby Street, Bradford, BD5 7NU, United Kingdom
NOTIFY_EMAIL=hello@yourdomain.co.uk
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
PRIVACY_POLICY_VERSION=1.0
INQUIRY_RETENTION_DAYS=730
STORAGE_PROVIDER=local
UPLOADS_DIR=/var/app-data/uploads
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_FILES_PER_INTAKE=200
UPLOAD_MAX_FILES_PER_PRODUCT=20
UPLOAD_MAX_TOTAL_MB_PER_INTAKE=150
PDF_REJECT_ACTIVE_CONTENT=true
FRONTEND_URL=https://yourdomain.co.uk
CLAMAV_HOST=
CLAMAV_PORT=3310
FRONTEND_DIST_DIR=dist
FORCE_HTTPS=false

